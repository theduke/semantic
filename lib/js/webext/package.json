{
  "name": "@semantic/webext",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "bundle": "npm run format:check && npm run check && npm test && npm run build",
    "check": "tsc --noEmit",
    "format": "prettier --write \"{src,tests,scripts,manifests}/**/*.{ts,json,mjs,css,html}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,tests,scripts,manifests}/**/*.{ts,json,mjs,css,html}\" \"*.{json,md}\"",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@semantic/sdk": "file:../sdk",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/webextension-polyfill": "^0.12.3",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "prettier": "^3.6.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
