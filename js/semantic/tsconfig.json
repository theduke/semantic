{
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "es2022",
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "lib": ["ES2022", "dom"],
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    // "types": ["vite/client"],
    // "noEmit": true,
    // "isolatedModules": true,
    // Required for Typescript project references to work.
    "composite": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "tests/**/*"]
}
